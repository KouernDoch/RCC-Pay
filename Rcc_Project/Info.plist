<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  App Transport Security exception for talking to the RCC-PAY backend over plain
	  HTTP during development (e.g. http://localhost:8080 from the simulator, or a LAN
	  IP from a device). Tighten or remove this before shipping a production build that
	  uses HTTPS. Other Info.plist keys (scene manifest, launch screen, orientations)
	  are still generated by GENERATE_INFOPLIST_FILE and merged on top of this file.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
